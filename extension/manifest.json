{
  "manifest_version": 3,
  "name": "Clockpane",
  "short_name": "Clockpane",
  "version": "0.2.0",
  "description": "World clocks and a time zone converter in your toolbar. Works offline, no tracking. Optional paid Pro adds more clocks, a meeting planner and more.",
  "author": "Larchwick",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Clockpane",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "script": "background.js" },
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": ["https://api.gumroad.com/*"]
}
