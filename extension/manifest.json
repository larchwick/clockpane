{
  "manifest_version": 3,
  "name": "Clockpane",
  "short_name": "Clockpane",
  "version": "0.1.0",
  "description": "World clocks and a time zone converter in your toolbar. Storage permission only, works offline, no tracking.",
  "author": "Larchwick",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Clockpane",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "permissions": ["storage"]
}
